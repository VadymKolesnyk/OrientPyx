<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OrientPyx.Tests</RootNamespace>
    <!-- The Presentation project is a WinExe; referencing it from a test project is fine, but the SDK
         must not try to make this assembly the app host. -->
    <UseAppHost>false</UseAppHost>
    <!-- Avalonia's own warning about referencing an executable project. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\OrientPyx.Presentation\OrientPyx.Presentation.csproj" />
    <ProjectReference Include="$(RepoRoot)src\OrientPyx.BusinessLogic\OrientPyx.BusinessLogic.csproj" />
    <ProjectReference Include="$(RepoRoot)src\OrientPyx.DataAccess\OrientPyx.DataAccess.csproj" />
    <ProjectReference Include="$(RepoRoot)src\OrientPyx.Localization\OrientPyx.Localization.csproj" />
    <!-- Build the standard plugins too (into artifacts/plugins, where the Debug catalog picks them up)
         without referencing their assemblies. -->
    <ProjectReference Include="$(RepoRoot)plugins\MissedControlPenalty\MissedControlPenalty.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(RepoRoot)plugins\WeightedRelay\WeightedRelay.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.0.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Approved results of the synthetic competition (see Support/SyntheticCompetition.cs). -->
    <None Include="Golden\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
