<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrientPyx.BusinessLogic\OrientPyx.BusinessLogic.csproj" />
    <ProjectReference Include="..\OrientPyx.DataAccess\OrientPyx.DataAccess.csproj" />
    <ProjectReference Include="..\OrientPyx.Localization\OrientPyx.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- Pin SQLitePCLRaw to the patched 3.x line (see DataAccess csproj: GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the icon into OrientPyx.exe so Explorer, the taskbar and Velopack's
         shortcuts/uninstaller entry all show it. -->
    <ApplicationIcon>Assets\orientpyx.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The produced executable is OrientPyx.exe (the project/namespace keep the .Presentation suffix).
         Avalonia's avares:// authority is the assembly name, so the App.axaml StyleIncludes reference
         avares://OrientPyx/... to match this. -->
    <AssemblyName>OrientPyx</AssemblyName>
  </PropertyGroup>

  <!-- Published packages (build/publish.ps1, build/publish-mac.sh — always with a runtime identifier) are precompiled
       (ReadyToRun): the .NET runtime ships that way, but Avalonia, EF Core and our own assemblies are IL only, so every
       start JIT-compiled the whole start-up path again. Measured 2026-11-23: main window 3.8–4.7 s → 1.8–2.4 s; the
       package grows by ~18 %. A plain build / dotnet run (no runtime identifier) is unaffected. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Release identity. Bump <Version> for each release; the publish script passes the same value to
       Velopack so the installed app can tell it is out of date. See build/publish.ps1. Product / Company /
       Authors are shared by every src project in src/Directory.Build.props. -->
  <PropertyGroup>
    <Version>0.9.10</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="OrientPyx.Plugins.Sdk" />
    <Using Include="OrientPyx.Plugins.Sdk.Toolkit" />
  </ItemGroup>

</Project>
