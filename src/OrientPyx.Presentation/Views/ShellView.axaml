<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OrientPyx.Presentation.ViewModels"
             xmlns:pages="using:OrientPyx.Presentation.ViewModels.Pages"
             xmlns:views="using:OrientPyx.Presentation.Views.Pages"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="OrientPyx.Presentation.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="pages:DashboardViewModel">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="pages:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="pages:CompetitionInfoViewModel">
            <views:CompetitionInfoView />
        </DataTemplate>
        <DataTemplate DataType="pages:CompetitionDaysViewModel">
            <views:CompetitionDaysView />
        </DataTemplate>
        <DataTemplate DataType="pages:ControlPointsViewModel">
            <views:ControlPointsView />
        </DataTemplate>
        <DataTemplate DataType="pages:GroupsViewModel">
            <views:GroupsView />
        </DataTemplate>
        <DataTemplate DataType="pages:ChipsViewModel">
            <views:ChipsView />
        </DataTemplate>
        <DataTemplate DataType="pages:ParticipantsViewModel">
            <views:ParticipantsView />
        </DataTemplate>
        <DataTemplate DataType="pages:PluginsViewModel">
            <views:PluginsView />
        </DataTemplate>
        <DataTemplate DataType="pages:PluginSettingsViewModel">
            <views:PluginSettingsView />
        </DataTemplate>
        <DataTemplate DataType="pages:RelayTeamsViewModel">
            <views:RelayTeamsView />
        </DataTemplate>
        <DataTemplate DataType="pages:RegionsViewModel">
            <views:RegionsView />
        </DataTemplate>
        <DataTemplate DataType="pages:ClubsViewModel">
            <views:ClubsView />
        </DataTemplate>
        <DataTemplate DataType="pages:DusshViewModel">
            <views:DusshView />
        </DataTemplate>
        <DataTemplate DataType="pages:FinishReadViewModel">
            <views:FinishReadView />
        </DataTemplate>
        <DataTemplate DataType="pages:RanksViewModel">
            <views:RanksView />
        </DataTemplate>
        <DataTemplate DataType="pages:PointsViewModel">
            <views:PointsView />
        </DataTemplate>
        <DataTemplate DataType="pages:EntryFeesViewModel">
            <views:EntryFeesView />
        </DataTemplate>
        <DataTemplate DataType="pages:ProtocolsViewModel">
            <views:ProtocolsView />
        </DataTemplate>
        <DataTemplate DataType="pages:SummaryProtocolsViewModel">
            <views:SummaryProtocolsView />
        </DataTemplate>
        <DataTemplate DataType="pages:SplitsExportViewModel">
            <views:SplitsExportView />
        </DataTemplate>
        <DataTemplate DataType="pages:MapCountsViewModel">
            <views:MapCountsView />
        </DataTemplate>
        <DataTemplate DataType="pages:DrawViewModel">
            <views:DrawView />
        </DataTemplate>
        <DataTemplate DataType="pages:ClassicDrawViewModel">
            <views:ClassicDrawView />
        </DataTemplate>
        <DataTemplate DataType="pages:StartProtocolsViewModel">
            <views:StartProtocolsView />
        </DataTemplate>
        <DataTemplate DataType="pages:OnlineResultsViewModel">
            <views:OnlineResultsView />
        </DataTemplate>
        <DataTemplate DataType="pages:MonitorResultsViewModel">
            <views:MonitorResultsView />
        </DataTemplate>
        <DataTemplate DataType="pages:PageViewModelBase">
            <views:PageView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <DockPanel LastChildFill="True" Background="{DynamicResource SurfacePage}">

        <!-- Plugin banners: a missing plugin for the active day (Р-2) and a plugin failure notice (Р-3). -->
        <StackPanel DockPanel.Dock="Top">
            <!-- Network: the station lost its host — the page stays visible with its last snapshot, editing is
                 blocked (the content below is disabled) until the connection is back. -->
            <Border Background="#D97706" Padding="28,8"
                    IsVisible="{Binding NetworkNotices.IsOffline}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:Icon Kind="TriangleAlert" Size="18" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NetworkNotices.Text}" Foreground="White" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource DangerBrush}" Padding="28,8"
                    IsVisible="{Binding PluginNotices.HasMissing}">
                <TextBlock Text="{Binding PluginNotices.MissingText}" Foreground="White" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource DangerBrush}" Padding="28,8"
                    IsVisible="{Binding PluginNotices.HasFailure}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="ghost small" Foreground="White"
                            Content="{Binding Localization[Common.Close]}"
                            Command="{Binding PluginNotices.DismissFailureCommand}" />
                    <TextBlock Text="{Binding PluginNotices.FailureText}" Foreground="White"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Content. No outer ScrollViewer here: it would hand the page infinite height, which
             breaks a DataGrid (it then renders all rows and loses its own horizontal/vertical
             scrollbars). Instead the padded Border fills the area with a bounded height, so grid
             pages let the DataGrid scroll itself. Tall static pages add their own ScrollViewer. -->
        <Panel>
            <Border Padding="28">
                <ContentControl Content="{Binding SelectedPage}"
                                IsEnabled="{Binding NetworkNotices.IsOnline}" />
            </Border>
            <!-- Network: writes waiting for the host through a short outage. A pill over the top padding, so it neither
                 shifts the page nor covers it, and editing goes on — the writes retry by themselves. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,28,0"
                    Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="11"
                    Padding="10,2"
                    IsVisible="{Binding NetworkNotices.IsSaving}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:Icon Kind="RefreshCw" Size="13" Foreground="#92400E" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NetworkNotices.SavingText}" Foreground="#92400E" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>

    </DockPanel>

</UserControl>
