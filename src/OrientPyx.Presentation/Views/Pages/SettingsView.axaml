<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:OrientPyx.Presentation.ViewModels.Pages"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             xmlns:mcp="using:OrientPyx.Presentation.Services.Mcp"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="OrientPyx.Presentation.Views.Pages.SettingsView"
             x:DataType="pages:SettingsViewModel">

    <StackPanel Spacing="16" MaxWidth="560">

        <!-- Appearance -->
        <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[Settings.InterfaceSize]}" Classes="h2"
                               VerticalAlignment="Center"
                               FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />
                    <Button Classes="help"
                            Command="{Binding ShowBlockHelpCommand}" CommandParameter="Help.Settings.Appearance"
                            ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Slider Minimum="{Binding MinFontScale}"
                            Maximum="{Binding MaxFontScale}"
                            Value="{Binding FontScale, Mode=TwoWay}"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Width="320"
                            VerticalAlignment="Center" />
                    <Border Classes="badge" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FontScalePercent}" MinWidth="40" TextAlignment="Center" />
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding Localization[Settings.Language]}" Classes="label" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding Localization[Settings.Language.Ukrainian]}"
                            Classes="ghost"
                            Command="{Binding SetLanguageCommand}"
                            CommandParameter="uk-UA" />
                    <Button Content="{Binding Localization[Settings.Language.English]}"
                            Classes="ghost"
                            Command="{Binding SetLanguageCommand}"
                            CommandParameter="en-US" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Readout type (timing system) -->
        <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[Settings.Readout.Title]}" Classes="h2"
                               VerticalAlignment="Center"
                               FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />
                    <Button Classes="help"
                            Command="{Binding ShowBlockHelpCommand}" CommandParameter="Help.Settings.Readout"
                            ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                </StackPanel>
                <TextBlock Text="{Binding Localization[Settings.Readout.Hint]}" Classes="muted"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <RadioButton GroupName="ReadoutType"
                                 Content="{Binding Localization[Settings.Readout.SportIdent]}"
                                 IsChecked="{Binding IsSportIdent, Mode=TwoWay}" />
                    <RadioButton GroupName="ReadoutType"
                                 Content="{Binding Localization[Settings.Readout.SportTime]}"
                                 IsChecked="{Binding IsSportTime, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Data paths -->
        <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[Settings.Paths]}" Classes="h2"
                               VerticalAlignment="Center"
                               FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />
                    <Button Classes="help"
                            Command="{Binding ShowBlockHelpCommand}" CommandParameter="Help.Settings.Paths"
                            ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Localization[Settings.EventsPath]}" Classes="label" />
                    <TextBox Text="{Binding EventsPath, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="{Binding Localization[Settings.SavePaths]}"
                            Classes="accent"
                            Command="{Binding SavePathsCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding PathsSaved}">
                        <controls:Icon Kind="Check" Size="17"
                                  Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{Binding Localization[Settings.PathsSavedHint]}"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Online live-results connection (Supabase) -->
        <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[Settings.Online.Title]}" Classes="h2"
                               VerticalAlignment="Center"
                               FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />
                    <Button Classes="help"
                            Command="{Binding ShowBlockHelpCommand}" CommandParameter="Help.Settings.Online"
                            ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                </StackPanel>
                <TextBlock Text="{Binding Localization[Settings.Online.Hint]}" Classes="muted"
                           TextWrapping="Wrap" />

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Localization[Settings.Online.SupabaseUrl]}" Classes="label" />
                    <TextBox Text="{Binding OnlineSupabaseUrl, Mode=TwoWay}"
                             PlaceholderText="https://xxxxx.supabase.co" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Localization[Settings.Online.ServiceKey]}" Classes="label" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding OnlineServiceRoleKey, Mode=TwoWay}"
                                 PasswordChar="{Binding ServiceKeyPasswordChar}" />
                        <!-- Eye toggle: show / hide the secret key -->
                        <Button Grid.Column="1" Classes="ghost" Padding="8,4"
                                Command="{Binding ToggleRevealServiceRoleKeyCommand}"
                                ToolTip.Tip="{Binding Localization[Settings.Online.ServiceKeyReveal]}">
                            <Panel>
                                <controls:Icon Kind="Eye" Size="17" IsVisible="{Binding !RevealServiceRoleKey}" />
                                <controls:Icon Kind="EyeOff" Size="17" IsVisible="{Binding RevealServiceRoleKey}" />
                            </Panel>
                        </Button>
                        <!-- Copy the key to the clipboard -->
                        <Button Grid.Column="2" Classes="ghost" Padding="8,4"
                                Click="OnCopyServiceKeyClick"
                                ToolTip.Tip="{Binding Localization[Settings.Online.ServiceKeyCopy]}">
                            <controls:Icon Kind="Copy" Size="15" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Localization[Settings.Online.ServiceKeyHint]}" Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Localization[Settings.Online.PublicUrl]}" Classes="label" />
                    <TextBox Text="{Binding OnlinePublicBaseUrl, Mode=TwoWay}"
                             PlaceholderText="https://login.github.io/o-results" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Localization[Settings.Online.Interval]}" Classes="label" />
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="−" Command="{Binding DecrementOnlineIntervalCommand}"
                                Classes="ghost stepper" />
                        <TextBlock Text="{Binding OnlineIntervalSeconds}" MinWidth="44"
                                   VerticalAlignment="Center" TextAlignment="Center" FontWeight="Medium" />
                        <Button Content="+" Command="{Binding IncrementOnlineIntervalCommand}"
                                Classes="ghost stepper" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="{Binding Localization[Settings.Online.Save]}"
                            Classes="accent"
                            Command="{Binding SaveOnlineCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding OnlineSaved}">
                        <controls:Icon Kind="Check" Size="17"
                                  Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{Binding Localization[Settings.OnlineSavedHint]}"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Assistant (local MCP server) -->
        <Border Classes="card" Padding="22" DataContext="{Binding Mcp}" x:DataType="pages:McpSettingsViewModel">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[Mcp.Settings.Title]}" Classes="h2"
                               VerticalAlignment="Center"
                               FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />
                    <Button Classes="help"
                            Command="{Binding $parent[UserControl].((pages:SettingsViewModel)DataContext).ShowBlockHelpCommand}"
                            CommandParameter="Help.Settings.Mcp"
                            ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                </StackPanel>
                <TextBlock Text="{Binding Localization[Mcp.Settings.Hint]}" Classes="muted" TextWrapping="Wrap" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <ToggleSwitch Grid.Column="0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent="" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[Mcp.Settings.Enable]}" FontWeight="Medium" />
                        <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" Classes="muted" />
                    </StackPanel>
                </Grid>
                <Button Content="{Binding Localization[Mcp.Settings.ChoosePort]}" Classes="ghost small"
                        IsVisible="{Binding HasProblem}" Command="{Binding ChoosePortCommand}" HorizontalAlignment="Left" />

                <TextBlock Text="{Binding Localization[Mcp.Settings.Privacy.Note]}" Classes="muted" TextWrapping="Wrap" />

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Localization[Mcp.Settings.Mode]}" Classes="label" />
                    <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}" MinWidth="320">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="pages:McpModeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Localization[Mcp.Settings.Mode.Hint]}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsEnabled}">
                    <TextBlock Text="{Binding Localization[Mcp.Settings.Connect]}" Classes="label" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="{Binding Localization[Mcp.Settings.Claude.Connect]}" Classes="accent" Margin="0,0,8,8"
                                Command="{Binding ConnectClaudeDesktopCommand}" />
                        <Button Content="{Binding Localization[Mcp.Settings.Claude.Config]}" Classes="ghost" Margin="0,0,8,8"
                                Command="{Binding AddToClaudeConfigCommand}" />
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding ClientOptions}"
                                  SelectedItem="{Binding SelectedClient, Mode=TwoWay}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="pages:McpClientOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Classes="ghost" Click="OnCopyMcpConfigClick"
                                Content="{Binding Localization[Mcp.Settings.CopyConfig]}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="{Binding Localization[Mcp.Settings.Token]}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TokenShown}" VerticalAlignment="Center"
                                   FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Classes="ghost" Padding="8,4" Command="{Binding ToggleRevealTokenCommand}"
                                ToolTip.Tip="{Binding Localization[Mcp.Settings.TokenReveal]}">
                            <Panel>
                                <controls:Icon Kind="Eye" Size="17" IsVisible="{Binding !RevealToken}" />
                                <controls:Icon Kind="EyeOff" Size="17" IsVisible="{Binding RevealToken}" />
                            </Panel>
                        </Button>
                        <Button Grid.Column="3" Classes="ghost" Padding="8,4" Click="OnCopyMcpTokenClick"
                                ToolTip.Tip="{Binding Localization[Mcp.Settings.TokenCopy]}">
                            <controls:Icon Kind="Copy" Size="15" />
                        </Button>
                        <Button Grid.Column="4" Classes="ghost small" Command="{Binding NewTokenCommand}"
                                Content="{Binding Localization[Mcp.Settings.NewToken]}" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" />

                <StackPanel Spacing="6" IsVisible="{Binding HasJournal}">
                    <TextBlock Text="{Binding Localization[Mcp.Journal.Title]}" Classes="label" />
                    <ItemsControl ItemsSource="{Binding JournalItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="mcp:McpJournalItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Classes="muted" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Outcome}" Classes="muted" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasOutcome}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="ghost small" Command="{Binding UndoCommand}"
                                            IsVisible="{Binding CanUndo}"
                                            Content="{Binding $parent[UserControl].((pages:SettingsViewModel)DataContext).Localization[Mcp.Journal.Undo]}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Version & updates -->
        <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding Localization[Settings.Update.Title]}" Classes="h2"
                           FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Localization[Settings.Update.Version]}" Classes="label"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersion}" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding CanCheckForUpdates}">
                    <Button Content="{Binding Localization[Settings.Update.Check]}"
                            Classes="ghost"
                            IsVisible="{Binding !HasPendingUpdate}"
                            Command="{Binding CheckForUpdatesCommand}" />
                    <Button Content="{Binding Localization[Settings.Update.Install]}"
                            Classes="accent"
                            IsVisible="{Binding HasPendingUpdate}"
                            Command="{Binding DownloadUpdateCommand}" />
                    <TextBlock Text="{Binding UpdateStatus}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Localization[Settings.Update.DevHint]}" Classes="muted"
                           TextWrapping="Wrap" IsVisible="{Binding !CanCheckForUpdates}" />
            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>
