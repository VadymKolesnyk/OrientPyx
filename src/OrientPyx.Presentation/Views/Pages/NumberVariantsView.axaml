<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:OrientPyx.Presentation.ViewModels.Pages"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="640"
             x:Class="OrientPyx.Presentation.Views.Pages.NumberVariantsView"
             x:DataType="pages:NumberVariantsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">

        <!-- Heading + day picker (with the day lock) + export button -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{Binding Title, FallbackValue=''}" Classes="h1"
                           FontSize="{ReflectionBinding TitleFontSize, Source={StaticResource UiScale}}" />
                <TextBlock Text="{Binding Text}" Classes="subtitle"
                           TextWrapping="Wrap" Margin="0,0,16,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Classes="help" Command="{Binding ShowHelpCommand}"
                        ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                <controls:DaySelector VerticalAlignment="Center"
                                      ShowDays="{Binding ShowDaySelector}"
                                      ShowLock="{Binding CanToggleDayLock}"
                                      IsDayLocked="{Binding IsDayLocked}"
                                      ToggleLockCommand="{Binding ToggleDayLockCommand}"
                                      LockTooltip="{Binding Localization[DayLock.Lock.Tooltip]}"
                                      UnlockTooltip="{Binding Localization[DayLock.Unlock.Tooltip]}"
                                      SearchWatermark="{Binding Localization[Common.Search]}"
                                      DayOptions="{Binding DayOptions}"
                                      SelectedDay="{Binding SelectedDay, Mode=TwoWay}" />
                <Button Classes="accent" VerticalAlignment="Center"
                        Click="OnExportClick"
                        Content="{Binding Localization[NumberVariants.Export]}" />
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   Text="{Binding InfoText}" Classes="subtitle" TextWrapping="Wrap" />

        <!-- Nothing on the day: say where the numbers come from. -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="18,14" Margin="0,0,0,12"
                IsVisible="{Binding IsEmpty}">
            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" />
        </Border>

        <!-- How many numbers have a variation and what still needs a hand (red when anything does). -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="2,0,0,10"
                   IsVisible="{Binding HasSummary}"
                   Text="{Binding Summary}"
                   Classes.muted="{Binding !SummaryIsWarning}"
                   Classes.warning="{Binding SummaryIsWarning}" />

        <!-- The numbers with a variation above, the ones without below; the splitter shares the height. The lower part
             (and the splitter) disappear when every number has a variation — the code-behind collapses its row. -->
        <Grid Name="SplitGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="80" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="80" />
            </Grid.RowDefinitions>

            <!-- Number × variation table. Columns are built in code-behind (SheetColumnBuilder). -->
            <Border Grid.Row="0" Classes="card" ClipToBounds="True">
                <controls:SheetTable Name="Sheet"
                                     IsLocked="{Binding IsDayLocked}"
                                     LockedEditAttempted="OnLockedEditAttempted"
                                     ItemsSource="{Binding Rows}"
                                     Localization="{Binding Localization}"
                                     LayoutStore="{Binding LayoutStore}"
                                     LayoutKey="numbervariants" />
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="6"
                          Margin="0,6"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows"
                          Background="Transparent"
                          IsVisible="{Binding HasUnassigned}" />

            <!-- The numbered teams' legs and runners that should have a variation and have none. -->
            <DockPanel Grid.Row="2" LastChildFill="True" IsVisible="{Binding HasUnassigned}">
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="2,0,0,8">
                    <TextBlock Text="{Binding UnassignedTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UnassignedHint}"
                               Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="card" ClipToBounds="True">
                    <controls:SheetTable Name="UnassignedSheet"
                                         IsLocked="{Binding IsDayLocked}"
                                         LockedEditAttempted="OnLockedEditAttempted"
                                         ItemsSource="{Binding Unassigned}"
                                         Localization="{Binding Localization}"
                                         LayoutStore="{Binding LayoutStore}"
                                         LayoutKey="numbervariants.unassigned" />
                </Border>
            </DockPanel>
        </Grid>

    </DockPanel>

</UserControl>
