<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:OrientPyx.Presentation.ViewModels.Pages"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="640"
             x:Class="OrientPyx.Presentation.Views.Pages.NumberVariantsView"
             x:DataType="pages:NumberVariantsViewModel">

    <DockPanel LastChildFill="True">

        <!-- Heading + day picker + export button -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{Binding Title, FallbackValue=''}" Classes="h1"
                           FontSize="{ReflectionBinding TitleFontSize, Source={StaticResource UiScale}}" />
                <TextBlock Text="{Binding Localization[Page.NumberVariants.Text]}" Classes="subtitle" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Classes="help" Command="{Binding ShowHelpCommand}"
                        ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                <controls:DaySelector VerticalAlignment="Center"
                                      ShowDays="{Binding ShowDaySelector}"
                                      ShowLock="False"
                                      SearchWatermark="{Binding Localization[Common.Search]}"
                                      DayOptions="{Binding DayOptions}"
                                      SelectedDay="{Binding SelectedDay, Mode=TwoWay}" />
                <Button Classes="accent" VerticalAlignment="Center"
                        Click="OnExportClick"
                        Content="{Binding Localization[NumberVariants.Export]}" />
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   Text="{Binding Localization[NumberVariants.Info]}" Classes="subtitle" TextWrapping="Wrap" />

        <!-- Nothing assigned on the day: say where the numbers come from. -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="18,14" Margin="0,0,0,12"
                IsVisible="{Binding IsEmpty}">
            <TextBlock Text="{Binding Localization[NumberVariants.Empty]}" TextWrapping="Wrap" />
        </Border>

        <!-- Number × variation table. Columns are built in code-behind (SheetColumnBuilder). -->
        <Border Classes="card" ClipToBounds="True">
            <controls:SheetTable Name="Sheet"
                                 ItemsSource="{Binding Rows}"
                                 Localization="{Binding Localization}"
                                 LayoutStore="{Binding LayoutStore}"
                                 LayoutKey="numbervariants" />
        </Border>

    </DockPanel>

</UserControl>
