<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:OrientPyx.Presentation.ViewModels.Pages"
             xmlns:models="using:OrientPyx.BusinessLogic.Models"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="560"
             x:Class="OrientPyx.Presentation.Views.Pages.RelayTeamsView"
             x:DataType="pages:RelayTeamsViewModel">

    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" Classes="h1"
                           FontSize="{ReflectionBinding TitleFontSize, Source={StaticResource UiScale}}" />
                <TextBlock Text="{Binding Text}" Classes="subtitle" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="help" Command="{Binding ShowHelpCommand}" Margin="0,0,8,8"
                        ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                <controls:DaySelector VerticalAlignment="Center"
                                      Margin="0,0,8,8"
                                      ShowDays="{Binding ShowDaySelector}"
                                      ShowLock="{Binding CanToggleDayLock}"
                                      IsDayLocked="{Binding IsDayLocked}"
                                      ToggleLockCommand="{Binding ToggleDayLockCommand}"
                                      LockTooltip="{Binding Localization[DayLock.Lock.Tooltip]}"
                                      UnlockTooltip="{Binding Localization[DayLock.Unlock.Tooltip]}"
                                      SearchWatermark="{Binding Localization[Common.Search]}"
                                      DayOptions="{Binding DayOptions}"
                                      SelectedDay="{Binding SelectedDay, Mode=TwoWay}" />
                <Button Command="{Binding AddTeamCommand}" Classes="accent" Margin="0,0,8,8"
                        IsEnabled="{Binding HasRelayGroups}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <controls:Icon Kind="Plus" Size="15" Foreground="White" />
                        <TextBlock Text="{Binding Localization[RelayTeams.Add]}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- No relay group on the day: explain where a relay is set up. -->
        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="2,0,0,12"
                   IsVisible="{Binding !HasRelayGroups}"
                   Text="{Binding Localization[RelayTeams.NoRelayGroups]}" />

        <!-- «Масове створення команд»: N teams of a group numbered from X. -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="10,7" Margin="0,0,0,12"
                IsVisible="{Binding HasRelayGroups}" IsEnabled="{Binding !IsDayLocked}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Localization[RelayTeams.Bulk.Title]}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,2,16,2" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2">
                    <TextBlock Text="{Binding Localization[RelayTeams.Bulk.Group]}" VerticalAlignment="Center" />
                    <ComboBox MinWidth="140" ItemsSource="{Binding GroupOptions}"
                              SelectedItem="{Binding BulkGroup, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2">
                    <TextBlock Text="{Binding Localization[RelayTeams.Bulk.Count]}" VerticalAlignment="Center" />
                    <TextBox Width="60" Text="{Binding BulkCountText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2">
                    <TextBlock Text="{Binding Localization[RelayTeams.Bulk.FirstNumber]}" VerticalAlignment="Center" />
                    <TextBox Width="70" Text="{Binding BulkFirstNumberText, Mode=TwoWay}" />
                </StackPanel>
                <Button Classes="ghost" Margin="0,2,0,2" Command="{Binding CreateTeamsCommand}"
                        Content="{Binding Localization[RelayTeams.Bulk.Create]}" />
            </WrapPanel>
        </Border>

        <Grid ColumnDefinitions="*,6,360">
            <Border Grid.Column="0" Classes="card" ClipToBounds="True">
                <controls:SheetTable Name="Sheet"
                                     IsLocked="{Binding IsDayLocked}"
                                     LockedEditAttempted="OnLockedEditAttempted"
                                     ItemsSource="{Binding Teams}"
                                     Localization="{Binding Localization}"
                                     SelectedItem="{Binding SelectedTeam, Mode=TwoWay}"
                                     LayoutStore="{Binding LayoutStore}"
                                     LayoutKey="relay.teams"
                                     DeleteRequested="OnDeleteRequested" />
            </Border>

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" Background="Transparent" />

            <!-- Legs of the selected team + the runner search. -->
            <Border Grid.Column="2" Classes="card" Padding="12" IsEnabled="{Binding HasSelectedTeam}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Classes="subtitle" Margin="0,0,0,8"
                               Text="{Binding Localization[RelayTeams.Legs.Title]}" />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Legs}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pages:RelayLegRowViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Runner}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ResultText}" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Padding="8,2" Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{ReflectionBinding $parent[UserControl].DataContext.SelectedRunner, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.AssignLegCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{ReflectionBinding $parent[UserControl].DataContext.Localization[RelayTeams.Leg.Assign.Hint]}"
                                            Content="{ReflectionBinding $parent[UserControl].DataContext.Localization[RelayTeams.Leg.Assign]}" />
                                    <Button Grid.Column="2" Classes="ghost" Padding="6,2" Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasRunner}"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.ClearLegCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{ReflectionBinding $parent[UserControl].DataContext.Localization[RelayTeams.Leg.Clear]}"
                                            Content="✕" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                             Text="{Binding RunnerQuery, Mode=TwoWay}"
                             PlaceholderText="{Binding Localization[RelayTeams.Runner.Search]}" />
                    <ListBox ItemsSource="{Binding RunnerMatches}"
                             SelectedItem="{Binding SelectedRunner, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:RelayRunner">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding FullName}" />
                                    <TextBlock Classes="muted" FontSize="12"
                                               Text="{Binding Club}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>

</UserControl>
