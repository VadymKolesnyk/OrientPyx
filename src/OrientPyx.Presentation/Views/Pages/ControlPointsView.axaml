<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:OrientPyx.Presentation.ViewModels.Pages"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="560"
             x:Class="OrientPyx.Presentation.Views.Pages.ControlPointsView"
             x:DataType="pages:ControlPointsViewModel">

    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{Binding Title}" Classes="h1"
                           FontSize="{ReflectionBinding TitleFontSize, Source={StaticResource UiScale}}" />
                <TextBlock Text="{Binding Text}" Classes="subtitle" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="help" Command="{Binding ShowHelpCommand}"
                        ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                <controls:DaySelector VerticalAlignment="Center"
                                      ShowDays="{Binding ShowDaySelector}"
                                      ShowLock="{Binding CanToggleDayLock}"
                                      IsDayLocked="{Binding IsDayLocked}"
                                      ToggleLockCommand="{Binding ToggleDayLockCommand}"
                                      LockTooltip="{Binding Localization[DayLock.Lock.Tooltip]}"
                                      UnlockTooltip="{Binding Localization[DayLock.Unlock.Tooltip]}"
                                      SearchWatermark="{Binding Localization[Common.Search]}"
                                      DayOptions="{Binding DayOptions}"
                                      SelectedDay="{Binding SelectedDay, Mode=TwoWay}" />
                <ToggleSwitch IsChecked="{Binding ShowMapCoordinates, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              OnContent="{Binding Localization[ControlPoints.Coords.Map]}"
                              OffContent="{Binding Localization[ControlPoints.Coords.Map]}"
                              ToolTip.Tip="{Binding Localization[ControlPoints.Coords.Hint]}" />
                <Button Name="ImportButton" Classes="ghost" Click="OnImportClick"
                        IsEnabled="{Binding !IsDayLocked}"
                        ToolTip.Tip="{Binding Localization[Import.Hint]}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <controls:Icon Kind="Download" Size="15" />
                        <TextBlock Text="{Binding Localization[Import]}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddPointCommand}" Classes="accent"
                        IsEnabled="{Binding !IsDayLocked}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <controls:Icon Kind="Plus" Size="15" Foreground="White" />
                        <TextBlock Text="{Binding Localization[ControlPoints.Add]}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Spreadsheet-style table; the card border supplies the rounded frame. Columns are built
             in code-behind (SheetColumnBuilder) and handed to the shared SheetTable via Bands. -->
        <Border Classes="card" ClipToBounds="True">
            <controls:SheetTable Name="Sheet"
                                 IsLocked="{Binding IsDayLocked}"
                                 LockedEditAttempted="OnLockedEditAttempted"
                                 ItemsSource="{Binding Points}"
                                 Localization="{Binding Localization}"
                                 SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                                 LayoutStore="{Binding LayoutStore}"
                                 LayoutKey="controlpoints"
                                 DeleteRequested="OnDeleteRequested" />
        </Border>

    </DockPanel>

</UserControl>
