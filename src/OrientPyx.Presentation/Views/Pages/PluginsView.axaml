<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:OrientPyx.Presentation.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="OrientPyx.Presentation.Views.Pages.PluginsView"
             x:DataType="pages:PluginsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="820">

            <!-- Heading -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding Title}" Classes="h1"
                               FontSize="{ReflectionBinding TitleFontSize, Source={StaticResource UiScale}}" />
                    <TextBlock Text="{Binding Text}" Classes="subtitle" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="help" Command="{Binding ShowHelpCommand}"
                            ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                    <Button Content="{Binding Localization[Page.Plugins.OpenFolder]}"
                            Classes="ghost"
                            Command="{Binding OpenPluginsFolderCommand}" />
                </StackPanel>
            </Grid>

            <Border Classes="card" Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Localization[Page.Plugins.None]}" Classes="muted"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !HasPlugins}" />
                    <ItemsControl ItemsSource="{Binding Plugins}" IsVisible="{Binding HasPlugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pages:PluginItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Details}" Classes="muted" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasDescription}" />
                                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   IsVisible="{Binding IsError}" />
                                        <TextBlock Text="{Binding Folder}" Classes="muted" FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                                VerticalAlignment="Center">
                                        <Button Classes="ghost small"
                                                Content="{Binding $parent[UserControl].((pages:PluginsViewModel)DataContext).Localization[Page.Plugins.Settings]}"
                                                Command="{Binding $parent[UserControl].((pages:PluginsViewModel)DataContext).OpenSettingsCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanOpenSettings}" />
                                        <CheckBox Content="{Binding $parent[UserControl].((pages:PluginsViewModel)DataContext).Localization[Page.Plugins.Enabled]}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  IsVisible="{Binding CanToggle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
