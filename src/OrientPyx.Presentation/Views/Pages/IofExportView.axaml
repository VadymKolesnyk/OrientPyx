<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:OrientPyx.Presentation.ViewModels.Pages"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="640"
             x:Class="OrientPyx.Presentation.Views.Pages.IofExportView"
             x:DataType="pages:IofExportViewModel">

    <DockPanel LastChildFill="True">

        <!-- Heading + day picker + export button -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{Binding Title, FallbackValue=''}" Classes="h1"
                           FontSize="{ReflectionBinding TitleFontSize, Source={StaticResource UiScale}}" />
                <TextBlock Text="{Binding Localization[Page.IofExport.Text]}" Classes="subtitle" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Classes="help" Command="{Binding ShowHelpCommand}"
                        ToolTip.Tip="{Binding Localization[Help.Tooltip]}" />
                <controls:DaySelector VerticalAlignment="Center"
                                      ShowDays="{Binding ShowDaySelector}"
                                      ShowLock="False"
                                      IsDayLocked="{Binding IsDayLocked}"
                                      ToggleLockCommand="{Binding ToggleDayLockCommand}"
                                      LockTooltip="{Binding Localization[DayLock.Lock.Tooltip]}"
                                      UnlockTooltip="{Binding Localization[DayLock.Unlock.Tooltip]}"
                                      SearchWatermark="{Binding Localization[Common.Search]}"
                                      DayOptions="{Binding DayOptions}"
                                      SelectedDay="{Binding SelectedDay, Mode=TwoWay}" />
                <Button Classes="accent" VerticalAlignment="Center"
                        Click="OnGenerateClick"
                        IsEnabled="{Binding CanGenerate}"
                        Content="{Binding Localization[IofExport.Generate]}" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="720">

                <!-- What to export -->
                <Border Classes="card" Padding="22">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Localization[IofExport.Kind.Title]}" Classes="h2"
                                   FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />
                        <RadioButton GroupName="IofKind" IsChecked="{Binding IsResults, Mode=TwoWay}"
                                     Content="{Binding Localization[IofExport.Kind.Results]}" />
                        <RadioButton GroupName="IofKind" IsChecked="{Binding IsStartList, Mode=TwoWay}"
                                     Content="{Binding Localization[IofExport.Kind.Start]}" />
                    </StackPanel>
                </Border>

                <!-- Days (several days in one file) -->
                <Border Classes="card" Padding="22" IsVisible="{Binding HasSeveralDays}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Localization[IofExport.Days.Title]}" Classes="h2"
                                   FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />
                        <RadioButton GroupName="IofDays" IsChecked="{Binding SingleDay, Mode=TwoWay}"
                                     Content="{Binding Localization[IofExport.Days.Single]}" />
                        <RadioButton GroupName="IofDays" IsChecked="{Binding MultiDay, Mode=TwoWay}"
                                     Content="{Binding Localization[IofExport.Days.Multi]}" />
                        <ItemsControl ItemsSource="{Binding DayToggles}" IsVisible="{Binding MultiDay}" Margin="24,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:IofDayToggle">
                                    <CheckBox Content="{Binding Label}" Margin="0,0,16,4"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Localization[IofExport.Days.SummaryHint]}" Classes="subtitle"
                                   TextWrapping="Wrap" IsVisible="{Binding MultiDay}" />
                    </StackPanel>
                </Border>

                <!-- Groups -->
                <Border Classes="card" Padding="22">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Localization[IofExport.Groups.Title]}" Classes="h2"
                                       VerticalAlignment="Center"
                                       FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Classes="ghost" Padding="10,4"
                                        Content="{Binding Localization[IofExport.Groups.All]}"
                                        Command="{Binding SelectAllGroupsCommand}" />
                                <Button Classes="ghost" Padding="10,4"
                                        Content="{Binding Localization[IofExport.Groups.None]}"
                                        Command="{Binding SelectNoGroupsCommand}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:GroupToggle">
                                    <CheckBox Content="{Binding Name}" Margin="0,0,16,4" MinWidth="90"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Classes="card" Padding="22">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Localization[IofExport.Options.Title]}" Classes="h2"
                                   FontSize="{ReflectionBinding SectionFontSize, Source={StaticResource UiScale}}" />
                        <TextBlock Text="{Binding Localization[IofExport.Organisation]}" Classes="label" />
                        <RadioButton GroupName="IofOrganisation" IsChecked="{Binding OrganisationClub, Mode=TwoWay}"
                                     Content="{Binding Localization[IofExport.Organisation.Club]}" />
                        <RadioButton GroupName="IofOrganisation" IsChecked="{Binding OrganisationRegion, Mode=TwoWay}"
                                     Content="{Binding Localization[IofExport.Organisation.Region]}" />
                        <CheckBox IsChecked="{Binding IncludeBirthDates, Mode=TwoWay}" Margin="0,6,0,0"
                                  Content="{Binding Localization[IofExport.BirthDates]}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="22">
                    <TextBlock Text="{Binding Localization[IofExport.Info]}" Classes="subtitle" TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>
