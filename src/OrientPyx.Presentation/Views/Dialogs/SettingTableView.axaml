<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:OrientPyx.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:OrientPyx.Presentation.ViewModels.Dialogs"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="520"
             x:Class="OrientPyx.Presentation.Views.Dialogs.SettingTableView"
             x:DataType="dialogs:SettingTableViewModel">

    <!-- Centered card; the backdrop is supplied by the host overlay. -->
    <Border Background="{DynamicResource SurfaceCard}"
            CornerRadius="12"
            MinWidth="480" MaxWidth="760" MaxHeight="640"
            BoxShadow="0 10 40 0 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ClipToBounds="True">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="22,16">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" Classes="h2" />
                    <TextBlock Text="{Binding Localization[Dialog.SettingTable.Hint]}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Command="{Binding AddRowCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Kind="Plus" Size="15" />
                                <TextBlock Text="{Binding Localization[Dialog.SettingTable.AddRow]}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Content="{Binding Localization[Dialog.SettingTable.Reset]}"
                                Command="{Binding ResetToDefaultCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="{Binding Localization[Common.Cancel]}"
                                Classes="ghost"
                                Command="{Binding CancelCommand}" />
                        <Button behaviors:AutoFocus.OnOpen="True" Content="{Binding Localization[Common.Save]}"
                                Classes="accent"
                                Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Columns are built in code-behind (SheetColumnBuilder). -->
            <Border Classes="card" ClipToBounds="True" MinHeight="260" Margin="22,16">
                <controls:SheetTable Name="Sheet"
                                     ItemsSource="{Binding Rows}"
                                     Localization="{Binding Localization}"
                                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                     DeleteRequested="OnDeleteRequested" />
            </Border>

        </DockPanel>
    </Border>

</UserControl>
