<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:OrientPyx.Presentation.ViewModels.Dialogs"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             xmlns:behaviors="using:OrientPyx.Presentation.Behaviors"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="720"
             x:Class="OrientPyx.Presentation.Views.Dialogs.ChipScanView"
             x:DataType="dialogs:ChipScanViewModel">

    <!-- Centered card; the backdrop is supplied by the host overlay. -->
    <Border Background="{DynamicResource SurfaceCard}"
            CornerRadius="12"
            MinWidth="760" MaxWidth="960" MaxHeight="780"
            BoxShadow="0 10 40 0 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ClipToBounds="True">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="22,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" Classes="h2" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Localization[Participants.ChipScan.Hint]}"
                               Classes="subtitle" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding RemainingText}"
                               VerticalAlignment="Center" FontWeight="Medium" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                        <Button Content="{Binding Localization[Common.Cancel]}"
                                Classes="ghost"
                                Command="{Binding CancelCommand}" />
                        <Button Content="{Binding Localization[Participants.ChipScan.Apply]}"
                                Classes="accent"
                                Command="{Binding ApplyCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="22,14" LastChildFill="True">

                <!-- Set-up: the chip-type field and how each of its values is scanned. -->
                <Expander DockPanel.Dock="Top" Margin="0,0,0,10"
                          Header="{Binding Localization[Participants.ChipScan.Setup]}"
                          IsExpanded="{Binding IsSetupExpanded, Mode=TwoWay}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="4,8,4,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" VerticalAlignment="Center"
                                   Margin="0,0,12,8"
                                   Text="{Binding Localization[Participants.ChipScan.Field]}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                  ItemsSource="{Binding FieldOptions}"
                                  SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                  HorizontalAlignment="Left" MinWidth="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:ChipScanFieldOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" VerticalAlignment="Top"
                                   Margin="0,6,12,0"
                                   Text="{Binding Localization[Participants.ChipScan.Rules]}" />
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:ChipScanRuleViewModel">
                                    <Grid ColumnDefinitions="200,Auto,*" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   VerticalAlignment="Center" FontWeight="Medium" />
                                        <CheckBox Grid.Column="1" Margin="8,0,12,0"
                                                  Content="{Binding $parent[UserControl].((dialogs:ChipScanViewModel)DataContext).Localization[Participants.ChipScan.Rule.Own]}"
                                                  IsChecked="{Binding IsOwn, Mode=TwoWay}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding IsRental}">
                                            <TextBlock VerticalAlignment="Center" Classes="subtitle"
                                                       Text="{Binding $parent[UserControl].((dialogs:ChipScanViewModel)DataContext).Localization[Participants.ChipScan.Rule.Note]}" />
                                            <TextBox MinWidth="160"
                                                     Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="—" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Classes="subtitle" TextWrapping="Wrap"
                                   Text="{Binding Localization[Participants.ChipScan.RulesHint]}" />
                    </Grid>
                </Expander>

                <!-- The watched read-out file + a manual number box. -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto"
                      Margin="0,0,0,10">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="label" Text="{Binding Localization[Participants.ChipScan.File]}" />
                            <TextBlock Classes="subtitle" IsVisible="{Binding IsWatching}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Text="{Binding Localization[Participants.ChipScan.Watching]}" />
                            <TextBlock Classes="subtitle" IsVisible="{Binding !IsWatching}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding Localization[Participants.ChipScan.NotWatching]}" />
                        </StackPanel>
                        <TextBox Text="{Binding FilePath, Mode=TwoWay}" PlaceholderText="—" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Click="OnPickFileClick"
                            VerticalAlignment="Bottom" Margin="0,0,16,0"
                            Content="{Binding Localization[Participants.ChipScan.Pick]}" />
                    <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,8,0">
                        <TextBlock Classes="label" Text="{Binding Localization[Participants.ChipScan.Manual]}" />
                        <TextBox behaviors:AutoFocus.OnOpen="True" Name="ManualBox" MinWidth="150"
                                 Text="{Binding ManualNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInput.Digits="True"
                                 KeyDown="OnManualKeyDown"
                                 PlaceholderText="9007400" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="ghost" VerticalAlignment="Bottom"
                            Command="{Binding SubmitManualCommand}"
                            Content="{Binding Localization[Participants.ChipScan.Manual.Enter]}" />
                </Grid>

                <!-- The watched file has content the parser rejects (e.g. no Config+ header). -->
                <Border DockPanel.Dock="Top" IsVisible="{Binding HasFileError}"
                        Background="{DynamicResource DangerSurface}"
                        CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <controls:Icon Kind="TriangleAlert" Size="15" Margin="0,0,8,0"
                                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding FileError}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </Grid>
                </Border>

                <!-- What to touch to the station right now, for whom. -->
                <Border DockPanel.Dock="Top" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                        Background="{DynamicResource AccentSurface}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:Icon Kind="CreditCard" Size="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding NextPrompt}" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Per-type counters: «AIR: потрібно 2, залишилось 1». -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Counters}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:ChipScanCounter">
                            <Border Background="{DynamicResource SurfaceSubtle}" CornerRadius="6"
                                    Padding="10,5" Margin="0,0,8,6">
                                <TextBlock Text="{Binding Text}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- A held-back chip: contradicts the target's type; take it anyway or drop it. -->
                <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasPending}"
                        Background="{DynamicResource AccentSurface}"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                            <Button Classes="ghost" Command="{Binding DismissPendingCommand}"
                                    Content="{Binding Localization[Participants.ChipScan.Dismiss]}" />
                            <Button Classes="accent" Command="{Binding ForceAssignCommand}"
                                    Content="{Binding Localization[Participants.ChipScan.Force]}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*">
                            <controls:Icon Kind="CircleAlert" Size="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- The last scan's outcome: refused (red) or assigned (neutral); hidden behind the pending banner. -->
                <Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowWarning}"
                        Background="{DynamicResource DangerSurface}"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <controls:Icon Kind="TriangleAlert" Size="15" Margin="0,0,8,0"
                                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </Grid>
                </Border>
                <Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowInfo}"
                        Background="{DynamicResource SurfaceSubtle}"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <controls:Icon Kind="Check" Size="15" Margin="0,0,8,0"
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Our standard spreadsheet table; columns are built in code-behind. Bounded height so it
                     scrolls internally like every other SheetTable host. -->
                <Border Classes="card" ClipToBounds="True" MinHeight="160">
                    <controls:SheetTable Name="Sheet"
                                         ItemsSource="{Binding Rows}"
                                         Localization="{Binding Localization}"
                                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                         LayoutKey="participants.chipscan"
                                         LayoutStore="{Binding LayoutStore}" />
                </Border>

            </DockPanel>

        </DockPanel>
    </Border>

</UserControl>
