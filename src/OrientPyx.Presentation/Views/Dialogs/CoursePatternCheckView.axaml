<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:OrientPyx.Presentation.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
             x:Class="OrientPyx.Presentation.Views.Dialogs.CoursePatternCheckView"
             x:DataType="dialogs:CoursePatternCheckViewModel">

    <UserControl.Styles>
        <!-- Monospace boxes so the codes and bracket patterns line up. -->
        <Style Selector="TextBlock.code">
            <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.codebox">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <!-- One echoed punch: a rounded chip, muted when the pattern skipped it as a foreign punch. -->
        <Style Selector="Border.punch">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        </Style>
    </UserControl.Styles>

    <!-- Centered card; the backdrop is supplied by the host overlay. -->
    <Border Background="{DynamicResource SurfaceCard}"
            CornerRadius="12"
            MinWidth="520" MaxWidth="680"
            BoxShadow="0 10 40 0 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ClipToBounds="True"
            KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="22,16">
                <TextBlock Text="{Binding Localization[CoursePattern.Check.Title]}" Classes="h2"
                           VerticalAlignment="Center" />
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Classes="ghost"
                            Content="{Binding Localization[CoursePattern.Check.Clear]}"
                            Command="{Binding ClearCommand}" />
                    <Button Grid.Column="2"
                            Content="{Binding Localization[CoursePattern.Check.Close]}"
                            Classes="accent"
                            IsDefault="True" IsCancel="True"
                            Command="{Binding CloseCommand}" />
                </Grid>
            </Border>

            <ScrollViewer MaxHeight="460" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18" Spacing="14">

                    <TextBlock Text="{Binding Localization[CoursePattern.Check.Intro]}"
                               TextWrapping="Wrap" Classes="muted" />

                    <!-- The group's pattern, read-only, so the operator can see what they test against. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localization[CoursePattern.Check.PatternLabel]}"
                                   Classes="muted" />
                        <Border Classes="codebox">
                            <TextBlock Classes="code" Text="{Binding PatternText}" />
                        </Border>
                    </StackPanel>

                    <!-- The passage under test. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localization[CoursePattern.Check.OrderLabel]}"
                                   Classes="muted" />
                        <TextBox Name="OrderBox"
                                 FontFamily="Consolas, 'Courier New', monospace"
                                 PlaceholderText="{Binding Localization[CoursePattern.Check.Placeholder]}"
                                 Text="{Binding Order, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Verdict: ✓ with a confirmation, or ✕ naming the first control the pattern missed. -->
                    <Border Classes="codebox" IsVisible="{Binding HasVerdict}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock IsVisible="{Binding IsOrderValid}"
                                           Text="✓" FontWeight="Bold" FontSize="15"
                                           Foreground="#16A34A" VerticalAlignment="Center" />
                                <TextBlock IsVisible="{Binding !IsOrderValid}"
                                           Text="✕" FontWeight="Bold" FontSize="15"
                                           Foreground="#DC2626" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- The passage read back: each code marked on-course or foreign/extra. -->
                            <ItemsControl ItemsSource="{Binding Punches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="dialogs:CheckedPunchViewModel">
                                        <Border Classes="punch" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Code}"
                                                       FontFamily="Consolas, 'Courier New', monospace"
                                                       ToolTip.Tip="{Binding Hint}"
                                                       Opacity="{Binding Opacity}"
                                                       TextDecorations="{Binding Decorations}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Localization[CoursePattern.Check.PunchLegend]}"
                                       Classes="muted" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
