<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:OrientPyx.Presentation.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="360"
             x:Class="OrientPyx.Presentation.Views.Dialogs.DisciplineSettingsView"
             x:DataType="dialogs:DisciplineSettingsViewModel">

    <!-- Centered card; the backdrop is supplied by the host overlay. -->
    <Border Background="{DynamicResource SurfaceCard}"
            CornerRadius="12"
            MinWidth="420" MaxWidth="560"
            BoxShadow="0 10 40 0 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ClipToBounds="True">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="22,16">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Localization[Dialog.DisciplineSettings.Title]}" Classes="h2" />
                    <TextBlock Text="{Binding DayTitle}" Classes="muted" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="{Binding Localization[Common.Cancel]}"
                            Classes="ghost"
                            Command="{Binding CancelCommand}" />
                    <Button Content="{Binding Localization[Common.Save]}"
                            Classes="accent"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </Border>

            <ScrollViewer MaxHeight="520">
                <ItemsControl ItemsSource="{Binding Sections}" Margin="22,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:DisciplineSettingsSection">
                            <StackPanel Spacing="10" Margin="0,4,0,14">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="dialogs:SettingItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ScopeNote}" Classes="muted" FontSize="11"
                                                               IsVisible="{Binding HasScopeNote}" />
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Integer: a custom +/- stepper, not NumericUpDown (its Windows
                                                         automation peer crashes on spin). -->
                                                    <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsInt}">
                                                        <Button Content="−" Command="{Binding DecrementCommand}" Classes="ghost stepper" />
                                                        <TextBlock Text="{Binding Number}" MinWidth="44" VerticalAlignment="Center"
                                                                   TextAlignment="Center" FontWeight="Medium" />
                                                        <Button Content="+" Command="{Binding IncrementCommand}" Classes="ghost stepper" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Text}" MinWidth="160" IsVisible="{Binding IsDecimalOrText}" />
                                                    <CheckBox IsChecked="{Binding Flag}" IsVisible="{Binding IsBool}" />
                                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text}"
                                                              MinWidth="160" IsVisible="{Binding IsChoice}" />
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
