<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:OrientPyx.Presentation.ViewModels.Dialogs"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="560"
             x:Class="OrientPyx.Presentation.Views.Dialogs.ImportDuplicatesView"
             x:DataType="dialogs:ImportDuplicatesViewModel">

    <!-- Centered card; the backdrop is supplied by the host overlay. -->
    <Border Background="{DynamicResource SurfaceCard}"
            CornerRadius="12"
            MinWidth="520" MaxWidth="640" MaxHeight="680"
            BoxShadow="0 10 40 0 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ClipToBounds="True">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="22,16">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Icon Kind="TriangleAlert" Size="18"
                                       Foreground="{DynamicResource DangerBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" Classes="h2" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Classes="subtitle" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding Localization[ParticipantsImport.Duplicates.MergeAll]}"
                                Classes="ghost"
                                Command="{Binding MergeAllCommand}" />
                        <Button Content="{Binding Localization[ParticipantsImport.Duplicates.AllNew]}"
                                Classes="ghost"
                                Command="{Binding AllNewCommand}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Summary}" Classes="subtitle" VerticalAlignment="Center" />
                        <Button Content="{Binding Localization[Common.Cancel]}"
                                Classes="ghost"
                                Command="{Binding CancelCommand}" />
                        <Button Content="{Binding Localization[ParticipantsImport.Duplicates.Import]}"
                                Classes="accent"
                                Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- One card per clashing row: the file's details, then the mutually exclusive choices. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Cases}" Margin="22,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:ImportDuplicateItem">
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="8" ClipToBounds="True">
                                <StackPanel>
                                    <Border Background="{DynamicResource SurfaceSubtle}" Padding="14,10">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           VerticalAlignment="Center" />
                                                <Border Classes="badge">
                                                    <TextBlock Text="{Binding Group}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ImportedLine}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Choices}" Margin="14,8,14,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="dialogs:ImportDuplicateChoice">
                                                <RadioButton GroupName="{Binding GroupName}"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                             Margin="0,3">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding CandidateDetails}" TextWrapping="Wrap"
                                                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                                   IsVisible="{Binding IsMerge}" />
                                                        <TextBlock Text="{Binding MismatchText}" TextWrapping="Wrap"
                                                                   FontSize="12" Foreground="{DynamicResource DangerBrush}"
                                                                   IsVisible="{Binding IsMismatch}" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
