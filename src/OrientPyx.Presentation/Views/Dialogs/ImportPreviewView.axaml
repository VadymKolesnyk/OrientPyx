<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:OrientPyx.Presentation.ViewModels.Dialogs"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
             x:Class="OrientPyx.Presentation.Views.Dialogs.ImportPreviewView"
             x:DataType="dialogs:ImportPreviewViewModel">

    <UserControl.Resources>
        <!-- One row: a checkbox, the name + group badge, the details line and (updates) the changed fields. -->
        <DataTemplate x:Key="PreviewRow" x:DataType="dialogs:ImportPreviewItem">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2" HorizontalAlignment="Stretch">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="badge" IsVisible="{Binding HasGroup}">
                            <TextBlock Text="{Binding Group}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Details}" IsVisible="{Binding HasDetails}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    <ItemsControl ItemsSource="{Binding Changes}" IsVisible="{Binding HasChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Centered card; the backdrop is supplied by the host overlay. -->
    <Border Background="{DynamicResource SurfaceCard}"
            CornerRadius="12"
            MinWidth="620" MaxWidth="760" MaxHeight="760"
            BoxShadow="0 10 40 0 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ClipToBounds="True">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="22,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" Classes="h2" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Message}" Classes="subtitle" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" FontWeight="Medium"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                        <Button Content="{Binding Localization[Common.Cancel]}"
                                Classes="ghost"
                                Command="{Binding CancelCommand}" />
                        <Button Content="{Binding Localization[ParticipantsImport.Duplicates.Import]}"
                                Classes="accent"
                                Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,16" Spacing="16">

                    <!-- Added -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasAdded}">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                                <controls:Icon Kind="Plus" Size="16" Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AddedHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <Button Classes="ghost" Command="{Binding SelectAllAddedCommand}"
                                        Content="{Binding Localization[ParticipantsImport.Preview.SelectAll]}" />
                                <Button Classes="ghost" Command="{Binding DeselectAllAddedCommand}"
                                        Content="{Binding Localization[ParticipantsImport.Preview.DeselectAll]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <ItemsControl ItemsSource="{Binding Added}" ItemTemplate="{StaticResource PreviewRow}" />
                        </Border>
                    </StackPanel>

                    <!-- Updated -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasUpdated}">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                                <controls:Icon Kind="RefreshCw" Size="16" Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpdatedHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <Button Classes="ghost" Command="{Binding SelectAllUpdatedCommand}"
                                        Content="{Binding Localization[ParticipantsImport.Preview.SelectAll]}" />
                                <Button Classes="ghost" Command="{Binding DeselectAllUpdatedCommand}"
                                        Content="{Binding Localization[ParticipantsImport.Preview.DeselectAll]}" />
                            </StackPanel>
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <ItemsControl ItemsSource="{Binding Updated}" ItemTemplate="{StaticResource PreviewRow}" />
                        </Border>
                    </StackPanel>

                    <!-- Missing from the file: ticked = delete from the database -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasMissing}">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                                <controls:Icon Kind="UserMinus" Size="16" Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MissingHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <Button Classes="ghost" Command="{Binding SelectAllMissingCommand}"
                                        Content="{Binding Localization[ParticipantsImport.Preview.SelectAll]}" />
                                <Button Classes="ghost" Command="{Binding DeselectAllMissingCommand}"
                                        Content="{Binding Localization[ParticipantsImport.Preview.DeselectAll]}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Localization[ParticipantsImport.Preview.MissingHint]}"
                                   Classes="subtitle" TextWrapping="Wrap" />
                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <ItemsControl ItemsSource="{Binding Missing}" ItemTemplate="{StaticResource PreviewRow}" />
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
