<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:OrientPyx.Presentation.ViewModels.Dialogs"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:Class="OrientPyx.Presentation.Views.Dialogs.CustomFieldsView"
             x:DataType="dialogs:CustomFieldsViewModel">

    <!-- Centered card; the backdrop is supplied by the host overlay. -->
    <Border Background="{DynamicResource SurfaceCard}"
            CornerRadius="12"
            MinWidth="680" MaxWidth="860" MaxHeight="640"
            BoxShadow="0 10 40 0 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ClipToBounds="True">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="22,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Localization[CustomFields.Title]}" Classes="h2" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Localization[CustomFields.Hint]}"
                               Classes="subtitle" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Classes="ghost" Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:Icon Kind="Plus" Size="15" />
                            <TextBlock Text="{Binding Localization[CustomFields.Add]}" />
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding Localization[CustomFields.Close]}"
                            Classes="accent" HorizontalAlignment="Right"
                            Command="{Binding CloseCommand}" />
                </DockPanel>
            </Border>

            <DockPanel Margin="22,16" LastChildFill="True">

                <!-- Inline delete confirmation (a nested modal would replace this one). -->
                <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasPendingDelete}"
                        Background="{DynamicResource DangerSurface}"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                            <Button Classes="ghost" Content="{Binding Localization[Common.Cancel]}"
                                    Command="{Binding CancelDeleteCommand}" />
                            <Button Classes="accent" Content="{Binding Localization[CustomFields.Delete]}"
                                    Command="{Binding ConfirmDeleteCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DeletePrompt}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasWarning}"
                        Background="{DynamicResource DangerSurface}"
                        CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Icon Kind="TriangleAlert" Size="15"
                                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Columns are built in code-behind (SheetColumnBuilder). -->
                <Border Classes="card" ClipToBounds="True" MinHeight="240">
                    <controls:SheetTable Name="Sheet"
                                         ItemsSource="{Binding Rows}"
                                         Localization="{Binding Localization}"
                                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                         DeleteRequested="OnDeleteRequested" />
                </Border>

            </DockPanel>

        </DockPanel>
    </Border>

</UserControl>
