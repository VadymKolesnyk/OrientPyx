<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:OrientPyx.Presentation.Behaviors"
             xmlns:controls="using:OrientPyx.Presentation.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:OrientPyx.Presentation.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="320"
             x:Class="OrientPyx.Presentation.Views.Dialogs.UpdateAvailableView"
             x:DataType="dialogs:UpdateAvailableViewModel">

    <!-- Centered card; the backdrop is supplied by the host overlay. -->
    <Border Background="{DynamicResource SurfaceCard}"
            CornerRadius="12"
            MinWidth="460" MaxWidth="620"
            BoxShadow="0 10 40 0 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ClipToBounds="True"
            KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="22,16">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="15"
                            Background="{DynamicResource AccentSurface}"
                            VerticalAlignment="Center">
                        <controls:Icon Kind="Download" Size="17"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Localization[UpdateAvailable.Title]}" Classes="h2" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Classes="ghost"
                            Content="{Binding Localization[UpdateAvailable.Skip]}"
                            ToolTip.Tip="{Binding Localization[UpdateAvailable.SkipTip]}"
                            Command="{Binding SkipCommand}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding Localization[Common.Close]}"
                                IsCancel="True"
                                Command="{Binding CloseCommand}" />
                        <Button behaviors:AutoFocus.OnOpen="True"
                                Classes="accent"
                                IsDefault="True"
                                Command="{Binding InstallCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Kind="Download" Size="15" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Localization[UpdateAvailable.Install]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="22,18" Spacing="10">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Localization[UpdateAvailable.RestartHint]}" TextWrapping="Wrap" Classes="muted" />

                <!-- This version's section of «Що нового» on the documentation site, in the default browser. -->
                <Button Classes="ghost" HorizontalAlignment="Left" Margin="-8,0,0,0"
                        ToolTip.Tip="{Binding ChangelogUri}"
                        Click="OnChangelogClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:Icon Kind="ExternalLink" Size="15" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Localization[UpdateAvailable.Changelog]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Spacing="6" IsVisible="{Binding IsDownloading}">
                    <TextBlock Text="{Binding ProgressText}" Classes="muted" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" MinHeight="6" />
                </StackPanel>

                <TextBlock Text="{Binding Localization[UpdateAvailable.Failed]}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding Failed}" />
            </StackPanel>

        </DockPanel>
    </Border>

</UserControl>
