<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="using:OrientPyx.Presentation.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="200"
             x:Class="OrientPyx.Presentation.Views.Dialogs.ConfirmDialogView"
             x:DataType="dialogs:ConfirmDialogViewModel">

    <UserControl.Styles>
        <!-- Make the keyboard-focused footer button unmistakable: a thick accent ring around the
             button content. Tab / arrow keys move focus between the two buttons; Enter runs the
             focused one. Drawn for :focus-visible (keyboard focus) only, not on mouse clicks. -->
        <Style Selector="WrapPanel.dialog-actions > Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <!-- WrapPanel has no Spacing: the gap between the buttons is a left margin, and the top one
             separates the rows once a third button pushes the set onto two lines. -->
        <Style Selector="WrapPanel.dialog-actions > Button">
            <Setter Property="Margin" Value="10,4,0,0" />
        </Style>
    </UserControl.Styles>

    <!-- Centered card; the backdrop is supplied by the host overlay.
         TabNavigation=Cycle traps Tab inside the dialog: focus cycles between Cancel and Confirm
         and never leaks to the window behind the modal. -->
    <Border Background="{DynamicResource SurfaceCard}"
            CornerRadius="12"
            MinWidth="380" MaxWidth="520"
            BoxShadow="0 10 40 0 #40000000"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ClipToBounds="True"
            KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="22,16">
                <TextBlock Text="{Binding Title}" Classes="h2" VerticalAlignment="Center" />
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <!-- WrapPanel, not a horizontal StackPanel: a dialog with the optional third button can
                     carry three long labels, which a StackPanel would push past the card's MaxWidth and
                     off the edge. Wrapping drops them onto a second row instead. -->
                <WrapPanel Classes="dialog-actions" HorizontalAlignment="Right" Margin="-10,-4,0,0">
                    <!-- Hidden for a plain message box (IsMessage), which only needs the OK button. -->
                    <Button Content="{Binding CancelText}"
                            Classes="ghost"
                            IsCancel="True"
                            IsVisible="{Binding ShowCancel}"
                            Command="{Binding CancelCommand}" />
                    <!-- Optional second positive action (e.g. "swap the two chips"); hidden unless the
                         caller supplied AlternateKey. -->
                    <Button Content="{Binding AlternateText}"
                            Classes="ghost"
                            IsVisible="{Binding ShowAlternate}"
                            Command="{Binding AlternateCommand}" />
                    <Button Name="ConfirmButton"
                            Content="{Binding ConfirmText}"
                            Classes.danger="{Binding ShowDanger}"
                            IsDefault="True"
                            Command="{Binding ConfirmCommand}" />
                </WrapPanel>
            </Border>

            <!-- Body: message. Scrolls when the text is long (e.g. a confirmation that lists many
                 affected participants) so the card never grows past a usable height. -->
            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
