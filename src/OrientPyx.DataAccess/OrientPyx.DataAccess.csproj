<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OrientPyx.BusinessLogic\OrientPyx.BusinessLogic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel for the network host («Спільна робота»): a minimal in-process HTTP server that needs no URL ACL /
         admin rights, unlike HttpListener. Adds the ASP.NET Core runtime (~30 MB) to the self-contained package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <!-- Pin the SQLitePCLRaw stack to 3.x: EF Core 10 pulls 2.1.11 transitively, whose native
         SQLite (lib.e_sqlite3) is flagged by GHSA-2m69-gcr7-jv3q. 3.0.3 ships the patched native lib. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Microsoft.Extensions.DependencyInjection.Abstractions comes with Microsoft.AspNetCore.App (NU1510 if listed). -->
    <!-- GDI printing for split printouts; the API is used only under OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="OrientPyx.Plugins.Sdk" />
    <Using Include="OrientPyx.Plugins.Sdk.Toolkit" />
  </ItemGroup>

</Project>
