<Project>
  <!-- Shared settings of every plugin project under plugins/. Each plugin builds into
       artifacts/plugins/<Name>/<Name>.dll, the layout the application scans. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\plugins\$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against the SDK but do not copy it: at run time the application provides it. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\OrientPyx.Plugins.Sdk\OrientPyx.Plugins.Sdk.csproj"
                      Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
