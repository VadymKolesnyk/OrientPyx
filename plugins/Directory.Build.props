<Project>
  <!-- Shared settings of every plugin project under plugins/. Each plugin builds into
       artifacts/plugins/<Name>/<Name>.dll, the layout the application scans. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\plugins\$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- The standard plugins ship inside the OrientPyx package and are code-signed with it (SignPath,
         docs/code-signing.md), which requires the project's product name. Their own Version stays; the
         release build sets the product version to the app's (-p:InformationalVersion in build/publish.ps1). -->
    <Product>OrientPyx</Product>
    <Company>OrientPyx</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against the SDK but do not copy it: at run time the application provides it. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\OrientPyx.Plugins.Sdk\OrientPyx.Plugins.Sdk.csproj"
                      Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
